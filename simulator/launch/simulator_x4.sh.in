#!/bin/bash
set -e

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd -- "$SCRIPT_DIR"

: "${FLAIR_ROOT:?Load the FlAIR environment before running this script}"

if [ -f /proc/xenomai/version ]; then
    EXEC="./@SIMULATOR_EXECUTABLE_NAME@_rt"
else
    EXEC="./@SIMULATOR_EXECUTABLE_NAME@_nrt"
fi

if [ ! -x "$EXEC" ]; then
    printf 'ERROR: executable not found or not executable: %s/%s\n' \
        "$SCRIPT_DIR" "${EXEC#./}" >&2
    exit 1
fi
 
$EXEC -n Drone_0 -t x4 -p 9000 -a 127.0.0.1 -x simulator_x4.xml -o 10 -m $FLAIR_ROOT/flair-src/models -s $FLAIR_ROOT/flair-src/models/indoor_flight_arena.xml 