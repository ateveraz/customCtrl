#!/bin/bash
set -e

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd -- "$SCRIPT_DIR"

if [ -f /proc/xenomai/version ]; then
    EXEC="./@UAV_EXECUTABLE_NAME@_rt"
else
    EXEC="./@UAV_EXECUTABLE_NAME@_nrt"
fi

if [ ! -x "$EXEC" ]; then
    printf 'ERROR: executable not found or not executable: %s/%s\n' \
        "$SCRIPT_DIR" "${EXEC#./}" >&2
    exit 1
fi


$EXEC -n Drone_0 -a 127.0.0.1 -p 9000 -l /tmp -x setup_x4.xml -t x4_simu  